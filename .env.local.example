# Copy to .env.local and fill in your values.
# This file is gitignored — safe to commit as a template.

# API base URL — point this at your deployed backend in production.
NEXT_PUBLIC_API_URL=https://your-api-domain.com/api

# Canonical site URL used for SEO (sitemap, robots, canonical links).
NEXT_PUBLIC_SITE_URL=https://your-frontend-domain.com
